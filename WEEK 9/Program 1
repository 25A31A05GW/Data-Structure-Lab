#include <iostream>
using namespace std;

class Deque {
private:
    int arr[100];   
    int front, rear, size;

public:
    Deque(int n) {
        size = n;
        front = -1;
        rear = -1;
    }

    // Check if deque is full
    bool isFull() {
        return ((front == 0 && rear == size - 1) || (front == rear + 1));
    }

    // Check if deque is empty
    bool isEmpty() {
        return (front == -1);
    }

    // Insert element at front
    void insertFront(int key) {
        if (isFull()) {
            cout << "Deque is full\n";
            return;
        }
        if (front == -1) { // first element
            front = rear = 0;
        } else if (front == 0) {
            front = size - 1;
        } else {
            front = front - 1;
        }
        arr[front] = key;
    }

    // Insert element at rear
    void insertRear(int key) {
        if (isFull()) {
            cout << "Deque is full\n";
            return;
        }
        if (front == -1) { // first element
            front = rear = 0;
        } else if (rear == size - 1) {
            rear = 0;
        } else {
            rear = rear + 1;
        }
        arr[rear] = key;
    }

    // Delete element from front
    void deleteFront() {
        if (isEmpty()) {
            cout << "Deque is empty\n";
            return;
        }
        if (front == rear) { // only one element
            front = rear = -1;
        } else if (front == size - 1) {
            front = 0;
        } else {
            front = front + 1;
        }
    }

    // Delete element from rear
    void deleteRear() {
        if (isEmpty()) {
            cout << "Deque is empty\n";
            return;
        }
        if (front == rear) { // only one element
            front = rear = -1;
        } else if (rear == 0) {
            rear = size - 1;
        } else {
            rear = rear - 1;
        }
    }

    // Get front element
    int getFront() {
        if (isEmpty()) {
            cout << "Deque is empty\n";
            return -1;
        }
        return arr[front];
    }

    // Get rear element
    int getRear() {
        if (isEmpty() || rear < 0) {
            cout << "Deque is empty\n";
            return -1;
        }
        return arr[rear];
    }
};

int main() {
    Deque dq(5);

    dq.insertRear(10);
    dq.insertRear(20);
    dq.insertFront(5);
    dq.insertFront(2);

    cout << "Front element: " << dq.getFront() << endl;
    cout << "Rear element: " << dq.getRear() << endl;

    dq.deleteFront();
    cout << "After deleting front, new front: " << dq.getFront() << endl;

    dq.deleteRear();
    cout << "After deleting rear, new rear: " << dq.getRear() << endl;

    return 0;
}
